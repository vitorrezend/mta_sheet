# Example .env file for MTA Sheet
# Configure the SQLite database path here without recompiling the project.

# If not set, it defaults to 'mta_sheet.db' in the current directory.
# You can use a relative or absolute path.
# The 'sqlite:' prefix is optional as the app will add it if missing.

DATABASE_URL=sqlite:mta_sheet.db

# Example for a different path:
# DATABASE_URL=sqlite:./data/my_characters.sqlite
