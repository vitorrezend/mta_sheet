# ==============================================================================
# MTA Sheet - Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para '.env' e ajuste conforme o seu ambiente local.
# NUNCA commite o seu '.env' real com senhas ou tokens!
# ==============================================================================

# --- Banco de Dados SQLite ---
# Em Dev Local: sqlite:mta_sheet_dev.db
# Em Produção Docker: sqlite:/app/data/mta_sheet.db?mode=rwc
DATABASE_URL=sqlite:mta_sheet_dev.db

# --- Endereço e Porta do Servidor ---
# Em Dev Local: 0.0.0.0:3000
# Em Produção: 0.0.0.0:8080 (ou atrás do Caddy/Nginx)
LEPTOS_SITE_ADDR=0.0.0.0:3000

# --- Nível de Logs do Rust (trace, debug, info, warn, error) ---
RUST_LOG=info

# --- Administradores do Sistema (separados por vírgula) ---
ADMIN_USERNAMES=admin,mestre

# --- DuckDNS (Opcional - Usado em scripts de sincronização) ---
# DUCKDNS_TOKEN=seu-token-uuid-aqui
# DUCKDNS_DOMAINS=mta-sheet,wod-sheet
